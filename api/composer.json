{
    "name": "toscm/pauk-api",
    "description": "pauk flashcard HTTP API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Pauk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pauk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
