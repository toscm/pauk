StatusBar {
    background: $panel;
    color: $text-muted;
    padding: 0 1;
    height: auto;
    width: 100%;
}

#home {
    align: center middle;
    height: 100%;
}

#logo {
    width: auto;
    color: $primary;
    text-style: bold;
}

#tagline {
    width: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#home-menu {
    width: 40;
    max-height: 12;
}

#quiz {
    padding: 1 2;
}

#question {
    margin-bottom: 1;
}

#choices, #match-choices {
    max-height: 12;
}

#match-left {
    text-style: bold;
    margin-bottom: 1;
}

#feedback {
    margin-top: 1;
    text-style: bold;
}

#feedback.good { color: $success; }
#feedback.typo { color: $warning; }
#feedback.bad { color: $error; }

/* compact, text-only buttons: one row tall, no heavy border */
.compact-buttons {
    height: auto;
    margin-top: 1;
}

.compact-buttons Button {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 2;
    margin-right: 2;
    background: $panel;
    color: $text;
}

.compact-buttons Button:hover {
    background: $primary;
    color: $text;
}

#result {
    padding: 1 2;
}

#trophy {
    color: $warning;
    text-style: bold;
}

#rank-line {
    color: $warning;
    text-style: bold;
    margin-bottom: 1;
}

#stats-text, #result-text {
    padding: 0 2;
}

#quest {
    padding: 1 2;
}

#quest-scenario {
    margin-bottom: 1;
}

#quest-log {
    height: auto;
    margin-bottom: 1;
}

#route {
    padding: 1 2;
    height: 1fr;
}

#route-here {
    margin-bottom: 1;
}

#route-moves {
    max-height: 12;
}

#route-outcome {
    margin-top: 1;
    text-style: bold;
}

#recall {
    padding: 1 2;
}

#recall-question {
    margin-bottom: 1;
}

#recall-answer {
    margin-top: 1;
}

#settings {
    padding: 1 2;
}

#settings-title {
    text-style: bold;
    margin-bottom: 1;
}

#pos-list {
    max-height: 4;
    width: 30;
}

#default-n {
    width: 20;
}
